{
  "manifest_version": 3,
  "name": "Mais Acessível — Vendas e Atendimento",
  "version": "2.1.2",
  "description": "Assistente de vendas da Mais Acessível: liga o app da empresa ao Bling e ao WhatsApp Web.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://www.bling.com.br/*",
    "https://rauldneto.github.io/*",
    "https://web.whatsapp.com/*",
    "https://maisacessivel-1d0ad-default-rtdb.firebaseio.com/*",
    "https://soft-limit-b3a1.rauldias.workers.dev/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.bling.com.br/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://rauldneto.github.io/mais-acessivel-app/*"
      ],
      "js": [
        "app-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "short_name": "Mais Acessível"
}