{
  "manifest_version": 3,
  "name": "Mais Acessível — Vendas e Atendimento",
  "version": "2.4.2",
  "description": "Assistente de vendas da Mais Acessível: Bling, WhatsApp, consulta automática CENPROT e firewall de domínios.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "alarms",
    "notifications",
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "webNavigation",
    "cookies"
  ],
  "host_permissions": [
    "https://www.bling.com.br/*",
    "https://rauldneto.github.io/*",
    "https://web.whatsapp.com/*",
    "https://maisacessivel-1d0ad-default-rtdb.firebaseio.com/*",
    "https://soft-limit-b3a1.rauldias.workers.dev/*",
    "https://site.cenprotnacional.org.br/*",
    "https://*.cenprotnacional.org.br/*",
    "https://www.pesquisaprotesto.com.br/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.bling.com.br/*"
      ],
      "js": [
        "fb-auth.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://rauldneto.github.io/mais-acessivel-app/*"
      ],
      "js": [
        "app-bridge.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://site.cenprotnacional.org.br/*",
        "https://*.cenprotnacional.org.br/*",
        "https://www.pesquisaprotesto.com.br/*",
        "https://pesquisaprotesto.com.br/*",
        "https://*.pesquisaprotesto.com.br/*"
      ],
      "js": [
        "cenprot-reader.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "firewall-block.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["blocked.html"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "short_name": "Mais Acessível"
}
