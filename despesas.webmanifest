{
  "name": "Despesas · Mais Acessível",
  "short_name": "Despesas",
  "start_url": "./#celular",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#f2f2f7",
  "theme_color": "#0a7d6b",
  "lang": "pt-BR",
  "icons": [
    {
      "src": "despesas-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "despesas-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "./compartilhar",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "arquivos",
          "accept": [
            "image/*",
            "application/pdf",
            ".jpg",
            ".jpeg",
            ".png",
            ".pdf"
          ]
        }
      ]
    }
  },
  "id": "./despesas"
}